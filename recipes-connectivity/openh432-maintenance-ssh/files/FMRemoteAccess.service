[Unit]
Description=Fractal Microsystems key-only maintenance SSH
After=network.target
ConditionFileNotEmpty=/root/.ssh/authorized_keys

[Service]
Type=simple
StateDirectory=openh432-ssh
StateDirectoryMode=0700
UMask=0077
ExecStartPre=@LIBEXECDIR@/openh432-ssh/prepare-host-key
ExecStart=@LIBEXECDIR@/openh432-ssh/dropbear -F -E -s -j -k -p 22 -r /var/lib/openh432-ssh/host_ed25519
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
