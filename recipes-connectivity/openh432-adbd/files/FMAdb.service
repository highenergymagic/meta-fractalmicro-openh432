# SPDX-License-Identifier: MIT
[Unit]
Description=Authenticated USB debugging
Requires=FMAdbAuth.socket
After=FMAdbAuth.socket FMAccessibility.target
ConditionPathExists=/dev/usb-ffs/adb/ep0

[Service]
Type=exec
User=openh432-adb
Group=openh432-adb
Sockets=FMAdbAuth.socket
ExecStart=/usr/sbin/adbd
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=5
StateDirectory=openh432-adb-shell
StateDirectoryMode=0700
WorkingDirectory=/var/lib/openh432-adb-shell
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
StandardOutput=journal
StandardError=journal
