[Unit]
Description=Local accessible approval of ADB hosts
BindsTo=FMAdb.service
PartOf=FMAdb.service
After=FMAdb.service FMAccessibility.target
Conflicts=getty@tty8.service

[Service]
Type=exec
ExecStart=/usr/sbin/fm-adb-approval
User=root
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_TTY_CONFIG
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
TimeoutStopSec=5
