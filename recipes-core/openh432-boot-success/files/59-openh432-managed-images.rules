# SPDX-License-Identifier: MIT
# The loader and root handoff select these raw UBI images explicitly.
# Opening inactive static volumes just to identify filesystems triggers a full
# CRC scan. Leave checking to their consumers; never disable UBI verification.
# Match raw UBI only: ubiblock, MMC, USB and other volume discovery is unchanged.
SUBSYSTEM=="ubi", KERNEL=="ubi[0-9]*_[0-9]*", ATTR{name}=="kernel_a|kernel_b|recovery|systembase_a|systembase_b", ENV{UDEV_DISABLE_PERSISTENT_STORAGE_RULES_FLAG}="1"
