#!/bin/sh
# SPDX-License-Identifier: MIT
# Mount existing static systembase read-only. UBI may maintain writable NAND.
# Never format, replace images or create volumes during root handoff.
set -eu
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
# The console can be absent (for example, an unbound USB gadget). Under set -e
# a failed redirection would end PID 1, so console messages are never fatal.
console() {
    { echo "$*" >/dev/console; } 2>/dev/null || :
}
fail() {
    trap - EXIT
    echo "OpenH432 root handoff failed: $*" >&2
    console "OpenH432 root handoff failed: $*"
    /usr/libexec/openh432-initramfs-recovery "$*" || :
    # A managed failure must not be marked good or mount the opposite slot.
    # Return to the loader, which owns the persistent attempt budget.
    if [ -n "${managed:-}" ]; then
        sleep 2
        reboot -f || :
    fi
    # Unmanaged diagnostics (or a failed reset) remain available.
    while :; do sleep 3600; done
}
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mkdir -p /run
mount -t tmpfs -o mode=0755,size=10% tmpfs /run
# Keep helper diagnostics in RAM even when no host has opened the USB console.
exec 3>&1 4>&2
exec >/run/openh432-handoff.log 2>&1
trap 'fail "unexpected init exit ($?)"' EXIT
# The worker retains a private RAM root and device mounts across switch_root.
if [ -x /usr/libexec/openh432-start-early-sound ]; then
    /usr/libexec/openh432-start-early-sound >/run/openh432-early-sound.log 2>&1 || \
        console "Early audio setup failed; userspace may retry"
fi
# The fallback keeps explicit legacy/RAM boot profiles usable during migration.
# Managed boots carry exactly one loader-selected RAUC slot.
slot=$(cat /etc/openh432-root-slot)
managed=
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        rauc.slot=A|rauc.slot=B)
            [ -z "$managed" ] || fail "duplicate slot"
            managed=${arg#rauc.slot=}
            ;;
        rauc.slot=*) fail "invalid managed slot" ;;
    esac
done
case "$managed" in A) slot=a ;; B) slot=b ;; esac
case "$slot" in a|b) ;; *) fail "invalid slot" ;; esac
mtd=
for node in /sys/class/mtd/mtd[0-9]*; do
    [ -f "$node/name" ] || continue
    name=$(cat "$node/name")
    if [ "$name" = linux-ubi ] || [ "$name" = linux-reserved ]; then
        [ -z "$mtd" ] || fail "ambiguous NAND pool"
        mtd=${node##*/mtd}
    fi
done
[ -n "$mtd" ] || fail "NAND pool missing"
[ "$(cat /sys/class/mtd/mtd$mtd/offset)" = 4194304 ] || fail "NAND offset"
[ "$(cat /sys/class/mtd/mtd$mtd/size)" = 531628032 ] || fail "NAND size"
[ "$(cat /sys/class/mtd/mtd$mtd/erasesize)" = 131072 ] || fail "NAND erase geometry"
[ "$(cat /sys/class/mtd/mtd$mtd/writesize)" = 2048 ] || fail "NAND page geometry"
# The normal runtime allows UBI wear maintenance. Legacy read-only kernels
# remain mount-compatible; immutability belongs to the SquashFS root image.
ubiattach /dev/ubi_ctrl -m "$mtd" || fail "UBI attach"
ubi=
for node in /sys/class/ubi/ubi[0-9]*; do
    [ -f "$node/mtd_num" ] || continue
    if [ "$(cat "$node/mtd_num")" = "$mtd" ]; then
        [ -z "$ubi" ] || fail "ambiguous UBI"
        ubi=${node##*/}
    fi
done
[ -n "$ubi" ] || fail "UBI device missing"
volume=
for node in /sys/class/ubi/${ubi}_*; do
    [ -f "$node/name" ] || continue
    [ "$(cat "$node/name")" = "systembase_$slot" ] || continue
    [ -z "$volume" ] || fail "ambiguous root volume"
    [ "$(cat "$node/type")" = static ] || fail "root is not static"
    [ "$(cat "$node/corrupted")" = 0 ] || fail "corrupted root"
    [ "$(cat "$node/upd_marker")" = 0 ] || fail "incomplete root update"
    [ "$(cat "$node/data_bytes")" -gt 4096 ] || fail "empty root"
    volume=${node##*/}
done
[ -n "$volume" ] || fail "matching root absent"
ubiblock --create "/dev/$volume" || fail "ubiblock creation"
block="/dev/ubiblock${volume#ubi}"
/usr/libexec/openh432-verity-open "$volume" "$block" || fail "root integrity mapping"
echo "Verity ready $(cut -d ' ' -f 1 /proc/uptime)"
mkdir -p /lower /writable /newroot
mount -t squashfs -o ro /dev/mapper/systembase /lower || fail "SquashFS mount"
image_slot=$(cat /lower/usr/lib/openh432/root-slot)
[ "$image_slot" = any ] || [ "$image_slot" = "$slot" ] || fail "slot mismatch"
[ -x /lower/sbin/init ] || fail "systemd missing"
# Writable runtime state is volatile until userdata persistence is implemented.
mount -t tmpfs -o mode=0755,size=64m tmpfs /writable
mkdir /writable/upper /writable/work
mount -t overlay overlay -o lowerdir=/lower,upperdir=/writable/upper,workdir=/writable/work /newroot || fail "root overlay"
echo "Root mounts ready $(cut -d ' ' -f 1 /proc/uptime)"
mkdir -p /newroot/.openh432/lower /newroot/.openh432/writable /newroot/dev /newroot/proc /newroot/sys /newroot/run
mount --move /lower /newroot/.openh432/lower
mount --move /writable /newroot/.openh432/writable
mount --move /dev /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /run /newroot/run
if [ -f /newroot/usr/lib/openh432/persistent-storage ]; then
    read -r version blocks offset root_digest remainder < /etc/openh432/systembase.verity
    case "$slot" in a) persistent_slot=A ;; b) persistent_slot=B ;; esac
    if ! chroot /newroot /usr/libexec/openh432/storage-runtime activate "$root_digest" "$persistent_slot"; then
        # Recovery belongs to the initramfs, including its device and proc view.
        mount --move /newroot/run /run
        mount --move /newroot/sys /sys
        mount --move /newroot/proc /proc
        mount --move /newroot/dev /dev
        fail "persistent storage activation"
    fi
fi
read -r uptime unused </newroot/proc/uptime
echo "Switch root $uptime"
exec 1>&3 2>&4 3>&- 4>&-
exec switch_root /newroot /sbin/init
