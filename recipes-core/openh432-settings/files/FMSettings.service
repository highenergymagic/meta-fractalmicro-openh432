# SPDX-License-Identifier: MIT
[Unit]
Description=Fractal Microsystems typed settings
After=local-fs.target dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.fractalmicro.Settings1
ExecStart=/usr/libexec/openh432/settingsd
StateDirectory=fractalmicro/settings
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
