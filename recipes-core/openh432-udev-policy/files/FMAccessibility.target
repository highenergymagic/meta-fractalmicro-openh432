# SPDX-License-Identifier: MIT
[Unit]
Description=Local accessible console initialized
# Wants, not Requires: failed local accessibility must still allow repair over
# the network. BRLTTY reports readiness after configuring its screen and drivers.
Wants=getty@tty1.service FMBraille.service
After=getty@tty1.service FMBraille.service

[Install]
WantedBy=multi-user.target
