#!/bin/sh
# SPDX-License-Identifier: MIT
# Mount existing static systembase read-only. UBI may maintain writable NAND.
# Never format, replace images or create volumes during root handoff.
set -eu
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
fail() {
    echo "OpenH432 root handoff failed: $*" >/dev/console
    # Leave diagnostics available, without booting a different slot silently.
    while :; do sleep 3600; done
}
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
slot=$(cat /etc/openh432-root-slot)
case "$slot" in a|b) ;; *) fail "invalid slot" ;; esac
mtd=
for node in /sys/class/mtd/mtd[0-9]*; do
    [ -f "$node/name" ] || continue
    name=$(cat "$node/name")
    if [ "$name" = linux-ubi ] || [ "$name" = linux-reserved ]; then
        [ -z "$mtd" ] || fail "ambiguous NAND pool"
        mtd=${node##*/mtd}
    fi
done
[ -n "$mtd" ] || fail "NAND pool missing"
[ "$(cat /sys/class/mtd/mtd$mtd/offset)" = 4194304 ] || fail "NAND offset"
[ "$(cat /sys/class/mtd/mtd$mtd/size)" = 531628032 ] || fail "NAND size"
[ "$(cat /sys/class/mtd/mtd$mtd/erasesize)" = 131072 ] || fail "NAND erase geometry"
[ "$(cat /sys/class/mtd/mtd$mtd/writesize)" = 2048 ] || fail "NAND page geometry"
# The normal runtime allows UBI wear maintenance. Legacy read-only kernels
# remain mount-compatible; immutability belongs to the SquashFS root image.
ubiattach /dev/ubi_ctrl -m "$mtd" || fail "UBI attach"
ubi=
for node in /sys/class/ubi/ubi[0-9]*; do
    [ -f "$node/mtd_num" ] || continue
    if [ "$(cat "$node/mtd_num")" = "$mtd" ]; then
        [ -z "$ubi" ] || fail "ambiguous UBI"
        ubi=${node##*/}
    fi
done
[ -n "$ubi" ] || fail "UBI device missing"
volume=
for node in /sys/class/ubi/${ubi}_*; do
    [ -f "$node/name" ] || continue
    [ "$(cat "$node/name")" = "systembase_$slot" ] || continue
    [ -z "$volume" ] || fail "ambiguous root volume"
    [ "$(cat "$node/type")" = static ] || fail "root is not static"
    [ "$(cat "$node/corrupted")" = 0 ] || fail "corrupted root"
    [ "$(cat "$node/upd_marker")" = 0 ] || fail "incomplete root update"
    [ "$(cat "$node/data_bytes")" -gt 4096 ] || fail "empty root"
    volume=${node##*/}
done
[ -n "$volume" ] || fail "matching root absent"
ubiblock --create "/dev/$volume" || fail "ubiblock creation"
block="/dev/ubiblock${volume#ubi}"
mkdir -p /lower /writable /newroot
mount -t squashfs -o ro "$block" /lower || fail "SquashFS mount"
[ "$(cat /lower/usr/lib/openh432/root-slot)" = "$slot" ] || fail "slot mismatch"
[ -x /lower/sbin/init ] || fail "systemd missing"
# Writable runtime state is volatile until userdata persistence is implemented.
mount -t tmpfs -o mode=0755,size=64m tmpfs /writable
mkdir /writable/upper /writable/work
mount -t overlay overlay -o lowerdir=/lower,upperdir=/writable/upper,workdir=/writable/work /newroot || fail "root overlay"
mkdir -p /newroot/.openh432/lower /newroot/.openh432/writable /newroot/dev /newroot/proc /newroot/sys
mount --move /lower /newroot/.openh432/lower
mount --move /writable /newroot/.openh432/writable
mount --move /dev /newroot/dev
mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
exec switch_root /newroot /sbin/init
